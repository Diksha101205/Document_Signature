{
  "info": {
    "name": "Document Signature App",
    "description": "Day 7 Postman tests for auth, document upload/listing, and signature placement APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('health returns 200', () => pm.response.to.have.status(200));",
              "pm.test('service is available', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('register returns created or duplicate', () => pm.expect([201, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.test('register returns token', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
              "  pm.collectionVariables.set('authToken', json.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login returns 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('login returns token', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('authToken', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Current User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('current user returns 200', () => pm.response.to.have.status(200));",
              "pm.test('current user has email', () => pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('userEmail')));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Upload PDF Document",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Postman Test Document",
              "type": "text"
            },
            {
              "key": "document",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/docs/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "docs", "upload"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('upload returns 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('upload returns document id', () => pm.expect(json.document.id).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('documentId', json.document.id);",
              "pm.collectionVariables.set('previewUrl', json.document.previewUrl);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List Documents",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/docs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "docs"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('list documents returns 200', () => pm.response.to.have.status(200));",
              "pm.test('documents is an array', () => pm.expect(pm.response.json().documents).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Single Document",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/docs/{{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "docs", "{{documentId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('single document returns 200', () => pm.response.to.have.status(200));",
              "pm.test('single document id matches', () => pm.expect(pm.response.json().document.id).to.eql(pm.collectionVariables.get('documentId')));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Save Signature Position",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileId\": \"{{documentId}}\",\n  \"signer\": {\n    \"name\": \"{{signerName}}\",\n    \"email\": \"{{signerEmail}}\"\n  },\n  \"page\": 1,\n  \"x\": 120,\n  \"y\": 240,\n  \"width\": 180,\n  \"height\": 56\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/signatures",
          "host": ["{{baseUrl}}"],
          "path": ["api", "signatures"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('signature save returns 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('signature has coordinates', () => pm.expect(json.signature.coordinates.x).to.eql(120));",
              "pm.collectionVariables.set('signatureId', json.signature._id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List Signatures",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/docs/{{documentId}}/signatures",
          "host": ["{{baseUrl}}"],
          "path": ["api", "docs", "{{documentId}}", "signatures"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('list signatures returns 200', () => pm.response.to.have.status(200));",
              "pm.test('signatures is an array', () => pm.expect(pm.response.json().signatures).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "userName",
      "value": "Postman Tester"
    },
    {
      "key": "userEmail",
      "value": "postman.tester@example.com"
    },
    {
      "key": "userPassword",
      "value": "password123"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "previewUrl",
      "value": ""
    },
    {
      "key": "signerName",
      "value": "Client Signer"
    },
    {
      "key": "signerEmail",
      "value": "client.signer@example.com"
    },
    {
      "key": "signatureId",
      "value": ""
    }
  ]
}
