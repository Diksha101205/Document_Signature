{
  "info": {
    "name": "Document Signature App",
    "description": "Day 7 Postman tests for auth, document upload/listing, and signature placement APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('health returns 200', () => pm.response.to.have.status(200));",
              "pm.test('service is available', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('register returns created or duplicate', () => pm.expect([201, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.test('register returns token', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
              "  pm.collectionVariables.set('authToken', json.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login returns 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('login returns token', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('authToken', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Current User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('current user returns 200', () => pm.response.to.have.status(200));",
              "pm.test('current user has email', () => pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('userEmail')));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Upload PDF Document",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Postman Test Document",
              "type": "text"
            },
            {
              "key": "document",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/docs/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "docs", "upload"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('upload returns 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('upload returns document id', () => pm.expect(json.document.id).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('documentId', json.document.id);",
              "pm.collectionVariables.set('previewUrl', json.document.previewUrl);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List Documents",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/docs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "docs"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('list documents returns 200', () => pm.response.to.have.status(200));",
              "pm.test('documents is an array', () => pm.expect(pm.response.json().documents).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Single Document",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/docs/{{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "docs", "{{documentId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('single document returns 200', () => pm.response.to.have.status(200));",
              "pm.test('single document id matches', () => pm.expect(pm.response.json().document.id).to.eql(pm.collectionVariables.get('documentId')));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Save Signature Position",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileId\": \"{{documentId}}\",\n  \"signer\": {\n    \"name\": \"{{signerName}}\",\n    \"email\": \"{{signerEmail}}\"\n  },\n  \"page\": 1,\n  \"x\": 120,\n  \"y\": 240,\n  \"width\": 180,\n  \"height\": 56\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/signatures",
          "host": ["{{baseUrl}}"],
          "path": ["api", "signatures"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('signature save returns 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('signature has coordinates', () => pm.expect(json.signature.coordinates.x).to.eql(120));",
              "pm.collectionVariables.set('signatureId', json.signature._id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List Signatures",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/docs/{{documentId}}/signatures",
          "host": ["{{baseUrl}}"],
          "path": ["api", "docs", "{{documentId}}", "signatures"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('list signatures returns 200', () => pm.response.to.have.status(200));",
              "pm.test('signatures is an array', () => pm.expect(pm.response.json().signatures).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Send Signature Link",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/signatures/{{signatureId}}/send-link",
          "host": ["{{baseUrl}}"],
          "path": ["api", "signatures", "{{signatureId}}", "send-link"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('send link returns 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('signing url is returned', () => pm.expect(json.signingUrl).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('signingUrl', json.signingUrl);",
              "const token = json.signingUrl.split('/').pop();",
              "pm.collectionVariables.set('signingToken', token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Public Signature Link Lookup",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/public/signatures/{{signingToken}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "public", "signatures", "{{signingToken}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('public lookup returns 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('public lookup returns signer', () => pm.expect(json.signature.signer.email).to.eql(pm.collectionVariables.get('signerEmail')));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Generate Signed PDF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/docs/{{documentId}}/generate-signed-pdf",
          "host": ["{{baseUrl}}"],
          "path": ["api", "docs", "{{documentId}}", "generate-signed-pdf"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('signed pdf generation returns 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('signed preview url is returned', () => pm.expect(json.document.signedPreviewUrl).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('signedPreviewUrl', json.document.signedPreviewUrl);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Public Respond Accept Signature",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"signed\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/public/signatures/{{signingToken}}/respond",
          "host": ["{{baseUrl}}"],
          "path": ["api", "public", "signatures", "{{signingToken}}", "respond"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('public sign returns 200 or already signed', () => pm.expect([200, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.test('signature status is signed', () => pm.expect(json.signature.status).to.eql('signed'));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Public Respond Reject Signature",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"rejected\",\n  \"reason\": \"Document details need correction\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/public/signatures/{{signingToken}}/respond",
          "host": ["{{baseUrl}}"],
          "path": ["api", "public", "signatures", "{{signingToken}}", "respond"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('reject returns 200 or already completed', () => pm.expect([200, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.test('signature status is rejected', () => pm.expect(json.signature.status).to.eql('rejected'));",
              "  pm.test('rejection reason is saved', () => pm.expect(json.signature.rejectionReason).to.be.a('string').and.not.empty);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Audit Trail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/audit/{{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "audit", "{{documentId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('audit trail returns 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('audit trail is an array', () => pm.expect(json.auditTrail).to.be.an('array'));",
              "pm.test('audit records include actor and action', () => {",
              "  if (json.auditTrail.length > 0) {",
              "    pm.expect(json.auditTrail[0]).to.have.property('actorEmail');",
              "    pm.expect(json.auditTrail[0]).to.have.property('action');",
              "  }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "userName",
      "value": "Postman Tester"
    },
    {
      "key": "userEmail",
      "value": "postman.tester@example.com"
    },
    {
      "key": "userPassword",
      "value": "password123"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "previewUrl",
      "value": ""
    },
    {
      "key": "signedPreviewUrl",
      "value": ""
    },
    {
      "key": "signerName",
      "value": "Client Signer"
    },
    {
      "key": "signerEmail",
      "value": "client.signer@example.com"
    },
    {
      "key": "signatureId",
      "value": ""
    },
    {
      "key": "signingUrl",
      "value": ""
    },
    {
      "key": "signingToken",
      "value": ""
    }
  ]
}
